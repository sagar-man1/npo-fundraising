# SQLite file used by Prisma. Path is relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# Notion internal integration token (starts with ntn_).
# Create one at https://www.notion.so/my-integrations
NOTION_TOKEN=""

# Database IDs, taken from each database's Notion URL.
# CSR Pipeline Tracker
NOTION_PIPELINE_DB_ID=""
# Companies tracker under "IT/ITeS Companies: Engagement Tracker"
NOTION_COMPANIES_DB_ID=""

# Optional. Set a shared password to put the whole app behind a login.
# Leave empty for local use with no auth.
APP_PASSWORD=""
