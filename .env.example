# ─────────────────────────────────────────────────────────────────────────────
# The ONLY thing you must fill in is NOTION_TOKEN. Everything else already
# works, or is optional. Copy this file to .env and edit that one line.
# ─────────────────────────────────────────────────────────────────────────────

# Notion internal integration token. Starts with "ntn_".
# Get one at https://www.notion.so/my-integrations → New integration → copy the
# Internal Integration Secret. Then open each of the three databases below in
# Notion and do: ⋯ (top right) → Connections → Connect to → your integration.
NOTION_TOKEN=""

# ─── Already filled in — your four Notion databases ──────────────────────────
# CSR Pipeline Tracker
NOTION_PIPELINE_DB_ID="c3e3717bc996457088ceed297df3a5ca"
# Companies, inside the "IT/ITeS Companies: Engagement Tracker" page
NOTION_COMPANIES_DB_ID="37635dd262f780829e83c0c2f7c2272e"
# Donor CRM, inside the "Donor Pipeline — Active Threads" page
NOTION_DONORS_DB_ID="13e3f6c8d328400ba3244446ae6b2356"
# Research Pipeline (auto) — the database the scheduled Claude Routine writes
# into. With this set, the app gets research from Notion and needs no
# ANTHROPIC_API_KEY of its own.
NOTION_RESEARCH_DB_ID="e4e183d73e454d03a8594029768b33b9"

# ─── WhatsApp morning message ────────────────────────────────────────────────
# The contact to message, exactly as the chat is named in your WhatsApp.
WHATSAPP_CONTACT="Sagar Mandhani"
# "playwright" (recommended) or "computer-use".
WHATSAPP_DRIVER="playwright"
# Where the logged-in WhatsApp Web session is kept.
WHATSAPP_PROFILE_DIR=".whatsapp-profile"
# Keep "false" — a visible window is less likely to be challenged by WhatsApp.
WHATSAPP_HEADLESS="false"

# ─── Schedule ────────────────────────────────────────────────────────────────
# When the morning digest runs: minute hour day month weekday.
RESEARCH_CRON="30 7 * * *"
RESEARCH_TZ="Asia/Kolkata"

# ─── Optional ────────────────────────────────────────────────────────────────
# SQLite database file. Leave as is.
DATABASE_URL="file:./prisma/dev.db"

# Set a password to put the dashboard behind a login. Needed only if you open
# it to your network; leave empty for local use.
APP_PASSWORD=""

# Shared secret for POST /api/jobs/daily-research. Leave empty when the app is
# only reachable on localhost.
CRON_SECRET=""

# Only needed if you skip the Claude Routine and want the app to do the
# research itself. Leave empty when using the Routine.
ANTHROPIC_API_KEY=""
