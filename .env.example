# SQLite file used by Prisma. Path is relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# Notion internal integration token (starts with ntn_).
# Create one at https://www.notion.so/my-integrations
NOTION_TOKEN=""

# Database IDs, taken from each database's Notion URL.
# CSR Pipeline Tracker
NOTION_PIPELINE_DB_ID=""
# Companies tracker under "IT/ITeS Companies: Engagement Tracker"
NOTION_COMPANIES_DB_ID=""

# Optional. Set a shared password to put the whole app behind a login.
# Leave empty for local use with no auth.
APP_PASSWORD=""

# --- Daily research agent ---
# Anthropic API key. Required for the daily research run.
ANTHROPIC_API_KEY=""

# Cron for the morning run (minute hour day month weekday) and its timezone.
RESEARCH_CRON="30 7 * * *"
RESEARCH_TZ="Asia/Kolkata"

# Shared secret for POST /api/jobs/daily-research. Leave empty to allow
# unauthenticated triggers (fine when the app is only bound to localhost).
CRON_SECRET=""

# --- WhatsApp delivery ---
# "playwright" (deterministic, recommended) or "computer-use" (Claude-driven).
WHATSAPP_DRIVER="playwright"
# Contact name exactly as it appears in your WhatsApp chat list.
WHATSAPP_CONTACT="Sagar Mandhani"
# Where the logged-in WhatsApp Web session is stored.
WHATSAPP_PROFILE_DIR=".whatsapp-profile"
# Keep "false" — a visible window is less likely to be challenged by WhatsApp.
WHATSAPP_HEADLESS="false"
